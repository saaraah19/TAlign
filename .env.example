# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- Database (local dev outside Docker; docker-compose overrides these) ---
DATABASE_URL=postgresql+asyncpg://talign:talign@localhost:5432/talign
DATABASE_URL_SYNC=postgresql+psycopg2://talign:talign@localhost:5432/talign

# --- Browser access (CORS) ---
# Comma-separated exact origins allowed to call the API from a browser.
# For a deployment, put your frontend's URL here, e.g. https://talign-web.onrender.com
CORS_ORIGINS=http://localhost:3000

# --- Auth (Slice 1) ---
# Generate a real one for any deployment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=staging or production the app REFUSES to start if this is
# still the default (or shorter than 32 characters), or if DEBUG=true.
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# lax is right locally and when frontend + API share a site. If they are on
# different sites (e.g. two separate *.onrender.com services) use "none"
# (HTTPS only, so not with ENVIRONMENT=local).
COOKIE_SAMESITE=lax
# Failed-login throttling: after this many wrong passwords for one
# (client address, email) pair, sign-in is refused for the rest of the window.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# --- LLM Provider ---
# Talign defaults to Gemini. See app/core/llm_provider.py for the
# provider-agnostic abstraction — switching to openai/anthropic requires
# only changing LLM_PROVIDER and the matching API key below.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=gemini-2.5-flash

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
